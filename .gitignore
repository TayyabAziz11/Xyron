# AI Operator — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Environment & secrets (never commit)
.env
.env.local
.env.*
.secrets/
secrets/
credentials/
credentials.json
token.json
*_token.json
*.key
*.pem
*.cert
*.secret*

# Node / Next.js
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*

# Electron / Tauri build output — only binaries/build artifacts, NOT source code
desktop/dist/
desktop/out/
desktop-app/node_modules/
desktop-app/out/
desktop-app/release/
desktop-app/src-tauri/target/
*.exe
*.app
*.deb
*.dmg
*.AppImage

# Shared package node_modules
shared/node_modules/

# Runtime logs and checkpoints
backend/Logs/
logs/
*_checkpoint.json
*.pid
ralph_loop.log
**/ralph_loop.log
backend/system_log.md

# Runtime data (vector DB, brain state — rebuilt automatically)
backend/data/chroma/
backend/data/brain/

# Audio test recordings (generated locally, not needed for dev)
backend/data/rvc_tests/
backend/data/voice_tests/

# WhatsApp session (auth cookies — never commit)
.secrets/whatsapp_session/
.secrets/whatsapp_session_meta.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / local tools
.vscode/
.idea/
.obsidian/
.claude/
*.swp
*.swo
*~

# WSL / local runtime config (contains credentials)
.wslrun

# Unnecessary local assets
Public/

# Large model files (too big for GitHub — store separately)
backend/voice/models/*.onnx
backend/voice/models/*.bin
dataset/
dataset_processed/

# Misc
*.bak
*.backup
output.txt
*.pdf
tsconfig.tsbuildinfo
tsconfig*.tsbuildinfo
graphify-out/
