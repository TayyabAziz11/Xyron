# AI Operator — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Environment & secrets (never commit)
.env
.env.local
.env.*
.secrets/
secrets/
credentials/
credentials.json
token.json
*_token.json
*.key
*.pem
*.cert
*.secret*

# Node / Next.js
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*

# Electron build output
desktop/dist/
desktop/out/

# Runtime logs and checkpoints
backend/Logs/
*_checkpoint.json
*.pid
ralph_loop.log
**/ralph_loop.log

# WhatsApp session (auth cookies — never commit)
.secrets/whatsapp_session/
.secrets/whatsapp_session_meta.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~

# Misc
*.bak
*.backup
output.txt
*.pdf
tsconfig.tsbuildinfo
tsconfig*.tsbuildinfo
