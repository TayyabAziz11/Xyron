{
  "name": "xyron",
  "version": "1.0.0",
  "description": "Xyron — Voice Driven AI OS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npx electron-vite dev 2>&1 | grep -Ev 'ERROR:dbus|object_proxy|Connection refused|ALSA lib|PcmOpen|snd_|alsa_util|chunked_data_pipe|network_service' || true",
    "dev:wsl": "NO_AT_BRIDGE=1 PULSE_SERVER=unix:/mnt/wslg/PulseServer ALSA_CONFIG_PATH=/home/tayyab/.asoundrc DBUS_SESSION_BUS_ADDRESS=unix:abstract=/tmp/dbus-ai-operator npx electron-vite dev --no-sandbox 2>&1 | grep -Ev 'ERROR:dbus|ERROR:content.*network_service|object_proxy|Connection refused|ALSA lib|PcmOpen|snd_|alsa_util|chunked_data_pipe' || true",
    "build": "npx electron-vite build",
    "preview": "npx electron-vite preview",
    "package:win": "npx electron-vite build && npx electron-builder --win",
    "package:win:wsl": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --win --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.tayyabaziz.xyron",
    "productName": "Xyron",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
