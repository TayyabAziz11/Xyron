{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../shared/*"],
      "@desktop/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "index.html",
    "../shared/**/*"
  ],
  "exclude": [
    "src/renderer/**/*",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
