    "dotenv": "^16.4.7",
    "express": "4.22.2",
    "mime-types": "3.0.2",
    "pino": "9.6.0",
    "qrcode-terminal": "0.12.0",
    "sql.js": "^1.12.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
