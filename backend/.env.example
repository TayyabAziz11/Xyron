# AI Operator Backend Environment
# Copy to .env and fill in values. Never commit the real .env file.

OPENAI_API_KEY=your-openai-api-key-here
REPO_ROOT=.
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEBUG=true

# ── Cost guardrails ─────────────────────────────────────────────────────────
# Hard caps — prevents runaway costs from bugs or loops
XYRON_MAX_GPT4O_PER_HOUR=50
XYRON_MAX_MINI_PER_HOUR=200

# ── Whisper STT ─────────────────────────────────────────────────────────────
WHISPER_MODEL=small          # low-spec default; "medium" is the best speed/accuracy balance
                              # for Urdu on weak/laptop GPUs (live-measured: ~4s/utterance,
                              # near-exact accuracy). "large-v3-turbo" is MORE accurate but
                              # was the SLOWEST option on a T1200 (~6.8s) — its encoder is
                              # the same size as full large-v3, so it isn't the "fast" pick
                              # on low-end hardware despite that reputation on desktop GPUs.
                              # Do not use distil-large-v3 for Urdu — confirmed broken
                              # (hallucinates English instead of transcribing).
WHISPER_LANGUAGE=auto        # auto = detect per utterance | en = English only | ur = Urdu only
WHISPER_CONFIDENCE_THRESHOLD=-1.0
WHISPER_FAST_MODEL=base.en   # used for quick low-latency English-only passes
WHISPER_COMPUTE_TYPE=        # override faster-whisper compute type, e.g. "int8", "float16"

# ── Wake word ───────────────────────────────────────────────────────────────
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
WAKE_COOLDOWN_S=2.0
WAKE_MODELS_DIR=~/.xyron/wake_models
WAKE_THRESHOLDS={}           # JSON map of per-model threshold overrides

# ── TTS (voice output) ──────────────────────────────────────────────────────
ONNX_PROVIDER=                # e.g. "CUDAExecutionProvider" — empty = let kokoro_onnx decide
OPENAI_TTS_MODEL=tts-1        # tts-1 = low-latency; tts-1-hd = higher quality/slower
OPENAI_TTS_TIMEOUT_S=12.0

# Edge-TTS (native Pakistani Urdu voice, used for ur/ur_roman/mixed responses)
EDGE_TTS_URDU_VOICE=ur-PK-AsadNeural   # or ur-PK-UzmaNeural (female)
EDGE_TTS_TIMEOUT_S=6.0
EDGE_TTS_RATE=+0%            # e.g. "-10%" slower — tune by ear, default is the voice's natural pace
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# XTTS (multilingual voice cloning fallback)
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
MULTILINGUAL_TTS_PRELOAD=false   # preload + keep XTTS warm at startup

# RVC emotional voice conversion — Lightweight tier (pitch/EQ per mood via
# librosa+scipy, already installed — no model files needed). Full RVC (real
# trained voice-conversion models) stays off: the rvc_python package pulls in
# fairseq, which fails to import in this environment.
ENABLE_RVC=false
RVC_MODEL_DIR=                # default: ~/.xyron/models/rvc
RVC_DEFAULT_PRESET=neutral
RVC_DEVICE=auto                # "cuda", "cpu", or "auto"
RVC_MAX_LATENCY_MS=250
RVC_LIGHTWEIGHT=false

# ── Screen context ──────────────────────────────────────────────────────────
# DISABLED by default (was costing ~$0.10+/day in vision API calls).
# Set to true only if you need "explain what's on my screen" feature.
SCREEN_CONTEXT_ENABLED=false
SCREEN_CONTEXT_INTERVAL=60

# ── Local/offline LLM fallback (Ollama) ─────────────────────────────────────
# Used when OpenAI is rate-limited or for pure-offline mode. Preloaded + kept
# warm at startup (see api/main.py).
# qwen3:4b was tried for a more natural tone but reverted — its default
# "thinking" mode adds ~9.5s of real generation latency with no reliable way
# to disable it on this Ollama version. qwen2.5:1.5b responds in ~170ms warm.
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b       # override to mistral:7b for complex tasks
OLLAMA_LOCAL_MODEL=qwen2.5:1.5b
OLLAMA_QWEN_TIMEOUT_S=20.0
OLLAMA_QWEN_KEEP_ALIVE=5m
LOCAL_ONLY_MODE=false          # force all NLU/routing through the local model, skip OpenAI

# ── Urdu Language Configuration ─────────────────────────────────────────────
# Response language mode:
#   auto        = mirror the user's input language (default, with session stickiness)
#   urdu        = always respond in Urdu (Nastaliq script)
#   roman_urdu  = always respond in Roman Urdu (Latin script, Urdu grammar)
#   english     = always respond in English
#   hindi       = always respond in Hindi
RESPONSE_LANGUAGE_MODE=auto
URDU_ACK_GEN_TIMEOUT_S=6.0
OPENAI_URDU_ONLY=true

# ── Operator Mode — human-like desktop automation ───────────────────────────
OPERATOR_MODE=false

# ── Filesystem intelligence ──────────────────────────────────────────────────
FS_SCAN_ROOTS=                 # comma-separated extra roots to index (optional)

# ── WhatsApp integration ─────────────────────────────────────────────────────
# Shared secret between the Python transport and the Node (Baileys) sidecar —
# generate a real random value, do not reuse the placeholder below.
WA_SIDECAR_HOST=127.0.0.1       # never 0.0.0.0 — see backend/integrations/whatsapp/sidecar/README
WA_SIDECAR_PORT=8734
WA_SIDECAR_API_KEY=changeme-generate-a-real-secret
WA_SIDECAR_TIMEOUT_S=20.0
WA_INCOMING_ANNOUNCE_ENABLED=true
WHATSAPP_HEADLESS=0
WHATSAPP_PHONE=                 # E.164 format, e.g. +923001234567
WHATSAPP_SESSION_DIR=           # default: <repo_root>/.secrets/whatsapp_openwa_session

# ── Gmail integration ─────────────────────────────────────────────────────────
GMAIL_OAUTH_CREDENTIALS=        # path to your Google OAuth client credentials.json

# ── Odoo integration ──────────────────────────────────────────────────────────
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_API_VERSION=2

# ── Xyron internal service URLs / CDP bridge ─────────────────────────────────
XYRON_API_BASE=http://localhost:8000
XYRON_BACKEND_URL=http://localhost:8000
XYRON_CDP_LOCAL_PORT=9222
XYRON_CDP_BRIDGE_PORT=9223
XYRON_CDP_PORT=9222
XYRON_CDP_PROFILE_DIR=          # optional override for the Chrome CDP profile directory
XYRON_IMMEDIATE_ACK_ENABLED=false

# ── Test-only flags (leave unset for normal use) ─────────────────────────────
LINKEDIN_REAL_TEST=0            # set to 1 to run LinkedIn smoke tests against the real site
